# Copy to `.env` (next to docker-compose.yml) and fill in.
# `.env` is read automatically by `docker compose`.

# Public hostname the site responds on. Must point to this server's public
# IP (A / AAAA records) before bringing the stack up — acme-companion runs an
# HTTP-01 challenge during the first `docker compose up`.
DOMAIN=as-it-sounds.example.com

# Contact address Let's Encrypt uses for renewal notices.
LETSENCRYPT_EMAIL=admin@example.com

# Max upload size (whole multipart body). Default 4096m at the proxy and
# 2048MB at the backend. Bump both if you upload larger media files.
CLIENT_MAX_BODY_SIZE=4096m
AIS_MAX_UPLOAD_MB=2048

# Backend log verbosity. Common values: info, debug, warn.
RUST_LOG=info
